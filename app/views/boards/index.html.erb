<style>
  .board-card { border-radius: 12px; border: 1px solid #e2e8f0; transition: transform 0.15s ease, box-shadow 0.15s ease; background: #fff; overflow: hidden; }
  .board-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.07); }
  .thumb-box { aspect-ratio: 16 / 9; background: #f8fafc radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 16px 16px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #f1f5f9; position: relative; }
  .thumb-box img { width: 100%; height: 100%; object-fit: contain; }
  .user-chip { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 3px 6px 3px 4px; display: inline-flex; align-items: center; }
  .user-avatar { width: 28px; height: 28px; border-radius: 50%; background: #2563eb; color: #fff; font-size: 0.78rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .user-chip form { margin: 0; display: inline-flex; }
  .switch-btn { background: #fff; border: 1px solid #cbd5e1; border-radius: 999px; font-size: 0.75rem; padding: 2px 10px; color: #475569; font-weight: 500; transition: all 0.15s ease; }
  .switch-btn:hover { background: #fee2e2; border-color: #fca5a5; color: #dc2626; }
</style>
<header class="bg-white border-bottom py-2 px-4 sticky-top shadow-sm">
  <div class="container d-flex align-items-center justify-content-between p-0">
    <a href="<%= root_path %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark" id="brandLink" title="Reload SyncCanvas">
      <span class="bg-primary text-white rounded-3 d-inline-flex align-items-center justify-content-center" style="width:36px;height:36px;">
        <i class="bi bi-easel2-fill"></i>
      </span>
      <span class="fw-bold fs-5">SyncCanvas</span>
    </a>
    <% if current_nickname.present? %>
      <div class="user-chip shadow-sm">
        <span class="user-avatar me-2"><%= current_nickname[0].upcase %></span>
        <span class="fw-semibold text-dark small me-3"><%= current_nickname %></span>
        <%= button_to clear_nickname_path, method: :delete, class: "switch-btn", title: "Switch to a different nickname" do %>
          <i class="bi bi-arrow-repeat me-1"></i>Switch
        <% end %>
      </div>
    <% end %>
  </div>
</header>
<main class="container py-4">
  <% if current_nickname.blank? %>
    <div class="row justify-content-center my-5 pt-4">
      <div class="col-md-5">
        <div class="card border-0 shadow rounded-4 p-4 text-center">
          <div class="mx-auto bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
            <i class="bi bi-person-workspace fs-2"></i>
          </div>
          <h4 class="fw-bold mb-1">Enter Your Nickname</h4>
          <p class="text-muted small mb-4">Provide any nickname to access and create live drawing boards.</p>
          <%= form_with url: set_nickname_path, method: :post, local: true do %>
            <div class="input-group">
              <input type="text" name="nickname" class="form-control form-control-lg" placeholder="e.g. Robiul" required autofocus>
              <button class="btn btn-primary px-4 fw-semibold" type="submit">Continue</button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4 pb-3 border-bottom">
      <div>
        <h4 class="fw-bold mb-0">Collaborative Boards</h4>
        <span class="text-muted small">Select an existing board or create a new one</span>
      </div>
      <%= form_with url: boards_path, method: :post, local: true, class: "d-flex gap-2" do %>
        <input type="text" name="title" class="form-control" placeholder="New board title (optional)..." style="max-width: 220px;">
        <button type="submit" class="btn btn-primary fw-semibold text-nowrap">
          <i class="bi bi-plus-lg me-1"></i>New Board
        </button>
      <% end %>
    </div>
    <% if @boards.empty? %>
      <div class="text-center py-5 bg-white rounded-4 border my-4">
        <i class="bi bi-vector-pen display-4 text-secondary opacity-50 d-block mb-2"></i>
        <h5 class="fw-bold">No Boards Created Yet</h5>
        <p class="text-muted small mb-3">Create the first collaborative whiteboard to begin drawing.</p>
        <%= button_to boards_path, method: :post, class: "btn btn-primary px-4" do %>
          <i class="bi bi-plus-circle me-1"></i>Create First Board
        <% end %>
      </div>
    <% else %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% @boards.each do |board| %>
          <% thumb = board.thumbnail %>
          <% role = board.role_for(current_nickname) %>
          <% pc = @page_counts[board.id] || 1 %>
          <div class="col">
            <div class="card board-card h-100">
              <a href="<%= board_path(board) %>" class="text-decoration-none">
                <div class="thumb-box">
                  <% if thumb.present? %>
                    <img src="<%= thumb %>" alt="<%= board.title %>">
                  <% else %>
                    <span class="text-muted small opacity-50"><i class="bi bi-brush me-1"></i>Blank Canvas</span>
                  <% end %>
                  <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2">
                    <%= pc %> <%= "page".pluralize(pc) %>
                  </span>
                </div>
              </a>
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="fw-bold text-truncate mb-0"><%= board.title %></h6>
                    <span class="badge bg-secondary text-uppercase" style="font-size:0.62rem;"><%= role %></span>
                  </div>
                  <p class="text-muted small mb-2" style="font-size:0.75rem;">By <%= board.owner_nickname %> &bull; <%= time_ago_in_words(board.updated_at) %> ago</p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                  <a href="<%= board_path(board) %>" class="btn btn-sm btn-outline-primary px-3">Open</a>
                  <% if role == "owner" %>
                    <%= button_to board_path(board), method: :delete, class: "btn btn-sm btn-link text-danger p-0" do %>
                      <i class="bi bi-trash3"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</main>
